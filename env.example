# Copy this file to `.env` and fill in your own values.
# `.env` is never committed — it's where your actual secrets live.
# Load it before running the backend, e.g.:  export $(cat .env | xargs)  (Linux/Mac)
# or use `python-dotenv` / your host's "Environment Variables" panel (see README).

# ---- Agentic AI layer (backend/agent.py) ----
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Free email alerts (Gmail SMTP with an App Password — also free) ----
# Create an App Password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the Gmail account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alert_bot@gmail.com
SMTP_PASS=your_16_char_app_password
ALERT_EMAIL_TO=your_real_email@example.com

# ---- Dashboard -> backend URL (change after you deploy the backend) ----
GEOALERT_API_URL=http://localhost:5000

# ---- Flask ----
PORT=5000
